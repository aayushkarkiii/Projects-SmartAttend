# ==========================================
# SmartAttend Environment Configuration
# ==========================================

# Flask Secret Key (generate a random 32-byte string in production)
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Web Server Port
PORT=5050
FLASK_DEBUG=True

# Default Admin Teacher Seed Credentials (only seeded if database is empty)
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
ADMIN_CONTACT=9800000000

# MySQL Database Settings (Optional - SQLite is used by default)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=face_recognition
